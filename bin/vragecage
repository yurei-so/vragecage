def command_lab_drive_zone(args: argparse.Namespace) -> int:
    if instance_is_active(args.instance):
        raise SystemExit(f"refusing to plan a lab command while instance is running: {args.instance}")
    inspection = subprocess.run(
        [script("fixture-contract.py"), "inspect", str(instance_path(args.instance))],
        text=True, capture_output=True,
    )
    if inspection.returncode != 0:
        raise SystemExit(inspection.stderr.strip() or "fixture inspection failed")
    fixture = json.loads(inspection.stdout)
    matches = [target for target in fixture.get("gps_targets", [])
               if isinstance(target, dict) and target.get("name") == args.zone]
    if len(matches) != 1:
        raise SystemExit(f"zone name must resolve exactly once in fixture GPS targets: {args.zone!r}")
    target = matches[0]
    depth_mode = args.depth_camera_id is not None
    max_speed = args.max_speed if args.max_speed is not None else (0.5 if depth_mode else 1.0)
    timeout_ticks = args.timeout_ticks if args.timeout_ticks is not None else (900 if depth_mode else 1800)
    command = [
        script("lab-contract.py"), "plan-drive-to", str(instance_path(args.instance)),
        str(args.controller_id), args.zone, str(target["x"]), str(target["y"]), str(target["z"]),
        "--max-speed", str(max_speed), "--arrival-radius", str(args.arrival_radius),
        "--timeout-ticks", str(timeout_ticks), "--offset-left", str(args.offset_left),
    ]
    if depth_mode:
        command.extend(["--depth-camera-id", str(args.depth_camera_id)])
    if args.start_delay_ticks:
        command.extend(["--start-delay-ticks", str(args.start_delay_ticks)])
    return run_checked(command)


def command_fixture_inspect(args: argparse.Namespace) -> int:
    return run_checked([
        script("fixture-contract.py"), "inspect", str(instance_path(args.instance)),
    ])


def command_lab_trial(args: argparse.Namespace) -> int:
    command = [sys.executable, script("lab-trial.py"), str(instance_path(args.instance)),
               "--cli", str(Path(__file__).resolve())]
    for name in ("fixture_id", "request_id", "controller_id", "depth_camera_id", "target", "snapshot_relative_path", "grid_name"):
        command.extend(["--" + name.replace("_", "-"), str(getattr(args, name))])
    if args.execute:
        command.extend(["--execute", "--expect-plan-sha256", args.expect_plan_sha256])
    return run_checked(command)


