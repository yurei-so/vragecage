#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shlex
import stat
import subprocess
import sys
import time
import uuid
from pathlib import Path


REMOTE_CLI = ".local/share/vragecage-worker/vragecage"
INSTANCE_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
ENGINES = ("proton", "magnetar")
MAX_UPLOAD_FILES = 100_000
MAX_UPLOAD_BYTES = 4 * 1024 * 1024 * 1024


def emit(value: object) -> None:
    print(json.dumps(value, sort_keys=True, separators=(",", ":")))


def validate_instance(value: str) -> str:
    if not INSTANCE_PATTERN.fullmatch(value):
        raise argparse.ArgumentTypeError(
            "instance must be 1-64 characters using letters, numbers, dot, underscore, or dash"
        )
    return value


def validate_observation_requirement(value: str) -> str:
    if not value or len(value) > 128 or "\n" in value or "\r" in value:
        raise argparse.ArgumentTypeError("observation requirement must be 1-128 characters on one line")
    return value


def validate_upload_tree(root: Path) -> tuple[int, int]:
    files = 0
    byte_count = 0
    for path in root.rglob("*"):
        mode = path.lstat().st_mode
        relative = path.relative_to(root)
        if stat.S_ISDIR(mode):
            continue
        if not stat.S_ISREG(mode):
            raise SystemExit(f"upload contains unsupported filesystem entry: {relative}")
        files += 1
        byte_count += path.stat().st_size
        if files > MAX_UPLOAD_FILES or byte_count > MAX_UPLOAD_BYTES:
            raise SystemExit(
                f"upload exceeds safety bound: {MAX_UPLOAD_FILES} files or {MAX_UPLOAD_BYTES} bytes"
            )
    return files, byte_count


def worker_root() -> Path:
    return Path(os.environ.get("VRAGECAGE_WORKER_ROOT", "~/.local/share/vragecage-worker")).expanduser()


def configured_host() -> str | None:
    if host := os.environ.get("VRAGECAGE_HOST"):
        return host
    config = Path.home() / ".config/vragecage/config.json"
    if not config.is_file():
        return None
    try:
        value = json.loads(config.read_text()).get("host")
    except (OSError, json.JSONDecodeError, AttributeError):
        return None
    return value if isinstance(value, str) and value.strip() else None


def run_checked(argv: list[str], *, env: dict[str, str] | None = None) -> int:
    return subprocess.run(argv, env=env).returncode


def script(name: str) -> str:
    path = worker_root() / name
    if not path.is_file():
        raise SystemExit(f"missing worker component: {path}")
    return str(path)


def instance_path(instance: str) -> Path:
    return worker_root() / "instances" / instance


def instance_engine(instance: str) -> str:
    marker = instance_path(instance) / ".vragecage-engine"
    if not marker.is_file():
        return "proton"
    value = marker.read_text(errors="replace").strip()
    if value not in ENGINES:
        raise SystemExit(f"invalid engine marker in {marker}: {value!r}")
    return value


def read_receipt(instance: str) -> tuple[dict[str, object] | None, int]:
    path = instance_path(instance)
    receipt_script = "magnetar-receipt.py" if instance_engine(instance) == "magnetar" else "server-receipt.py"
    result = subprocess.run(
        [script(receipt_script), str(path)], text=True, capture_output=True
    )
    if not result.stdout.strip():
        return None, result.returncode
    return json.loads(result.stdout), result.returncode


def persist_quarantine_receipt(instance: str, receipt: dict[str, object] | None) -> dict[str, object] | None:
    if (receipt is None or receipt.get("lab_authority") != "destructive-lab"
            or receipt.get("lab_contract_valid") is not True):
        return None
    root = instance_path(instance).resolve()
    active_path = root / ".vragecage-active-run.json"
    try:
        active = json.loads(active_path.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    run_id = receipt.get("lab_run_id")
    if (not isinstance(run_id, str) or len(run_id) != 32
            or any(character not in "0123456789abcdef" for character in run_id)):
        return None
    quarantine_path = Path(str(active.get("quarantine", "")))
    expected = root / "Quarantine" / run_id
    if (active.get("run_id") != run_id or quarantine_path.is_symlink()
            or quarantine_path != expected or not quarantine_path.is_dir()):
        return None
    quarantine = quarantine_path.resolve()
    receipt_bytes = (json.dumps(receipt, sort_keys=True, separators=(",", ":")) + "\n").encode()
    envelope = {
        "schema": "vragecage.lab-terminal-receipt.v1",
        "run_id": run_id,
        "receipt_sha256": hashlib.sha256(receipt_bytes).hexdigest(),
        "receipt": receipt,
    }
    encoded = (json.dumps(envelope, sort_keys=True, separators=(",", ":")) + "\n").encode()
    path = quarantine / "terminal-receipt.json"
    if path.exists():
        existing = path.read_bytes()
        if existing != encoded:
            raise SystemExit("refusing to replace a different lab terminal receipt")
        return {
            "path": f"Quarantine/{run_id}/terminal-receipt.json",
            "sha256": hashlib.sha256(existing).hexdigest(),
        }
    temporary = path.with_suffix(".tmp")
    temporary.write_bytes(encoded)
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)
    return {
        "path": f"Quarantine/{run_id}/terminal-receipt.json",
        "sha256": hashlib.sha256(encoded).hexdigest(),
    }


def command_doctor(args: argparse.Namespace) -> int:
    root = worker_root()
    checks = {
        "worker_root": root.is_dir(),
        "server": (root / "server/DedicatedServer64/SpaceEngineersDedicated.exe").is_file(),
        "prefix": (root / "prefix").is_dir(),
        "umu": (Path.home() / ".local/bin/umu-run").is_file(),
        "steamcmd_32": (root / "steamcmd/linux32/steamclient.so").is_file(),
        "steamcmd_64": (root / "steamcmd/linux64/steamclient.so").is_file(),
        "sdk_32": (Path.home() / ".steam/sdk32/steamclient.so").is_file(),
        "sdk_64": (Path.home() / ".steam/sdk64/steamclient.so").is_file(),
    }
    if args.engine == "magnetar":
        checks = {
            "worker_root": root.is_dir(),
            "server": (root / "server/DedicatedServer64/SpaceEngineersDedicated.exe").is_file(),
            "dotnet": (root / "dotnet/dotnet").is_file(),
            "magnetar": (root / "magnetar/current/MagnetarInterim.bin").is_file(),
            "steam_layout": (root / "magnetar-steam/steamapps/common/SpaceEngineersDedicatedServer/DedicatedServer64/SpaceEngineersDedicated.exe").is_file(),
            "steamworks_managed": (root / "magnetar/current/Libraries/MagnetarInterim/Steamworks.NET.dll").is_file(),
            "steamworks_native": (root / "magnetar/current/Libraries/MagnetarInterim/libsteam_api.so").is_file(),
        }
    ready = all(checks.values())
    emit({"schema": "vragecage.doctor.v1", "ready": ready, "checks": checks})
    return 0 if ready else 1


def command_prepare(args: argparse.Namespace) -> int:
    env = os.environ.copy()
    env["VRAGECAGE_WORKER_ROOT"] = str(worker_root())
    env["VRAGECAGE_BIND_IP"] = "0.0.0.0" if args.engine_ready else "127.0.0.1"
    if args.engine_ready:
        env["VRAGECAGE_ALLOW_NON_LOOPBACK"] = "1"
    if args.reprepare:
        env["VRAGECAGE_REPREPARE_INSTANCE"] = "1"
    prepare_script = "prepare-magnetar-instance.sh" if args.engine == "magnetar" else "prepare-instance.sh"
    status = run_checked([script(prepare_script), args.instance], env=env)
    if status == 0:
        emit(
            {
                "schema": "vragecage.operation.v1",
                "operation": "prepare",
                "instance": args.instance,
                "status": "prepared",
                "bind": env["VRAGECAGE_BIND_IP"],
                "engine": args.engine,
            }
        )
    return status


def unit_name(instance: str) -> str:
    return f"vragecage-{instance}.service"


def command_run(args: argparse.Namespace) -> int:
    root = worker_root()
    config = root / "instances" / args.instance / "SpaceEngineers-Dedicated.cfg"
    if not config.is_file():
        raise SystemExit(f"instance is not prepared: {args.instance}")
    if "<IP>127.0.0.1</IP>" in config.read_text(errors="replace"):
        raise SystemExit("loopback instances do not pass Steamworks initialization; prepare with --engine-ready")
    unit = unit_name(args.instance)
    active = subprocess.run(
        ["systemctl", "--user", "is-active", "--quiet", unit]
    ).returncode == 0
    if active:
        emit({"schema": "vragecage.operation.v1", "operation": "run", "instance": args.instance, "status": "already_running", "unit": unit})
        return 0
    engine = instance_engine(args.instance)
    env_args = [
        f"VRAGECAGE_WORKER_ROOT={root}",
        "VRAGECAGE_ALLOW_NON_LOOPBACK=1",
    ]
    lab_contract = root / "instances" / args.instance / ".vragecage-lab.json"
    if lab_contract.is_file():
        activation = subprocess.run(
            [script("lab-contract.py"), "activate", str(root / "instances" / args.instance)],
            text=True, capture_output=True,
        )
        if activation.returncode != 0:
            raise SystemExit(activation.stderr.strip() or "lab authority activation failed")
        active = json.loads(activation.stdout)
        env_args.extend([
            "VRAGECAGE_LAB_AUTHORITY=destructive-lab",
            f"VRAGECAGE_LAB_RUN_ID={active['run_id']}",
            f"VRAGECAGE_LAB_MANIFEST={lab_contract}",
            f"VRAGECAGE_QUARANTINE={active['quarantine']}",
        ])
        command_spec = active.get("command")
        if isinstance(command_spec, dict):
            env_args.extend([
                f"VRAGECAGE_LAB_COMMAND={command_spec.get('action', '')}",
                f"VRAGECAGE_LAB_OPERATION_ID={command_spec.get('operation_id', '')}",
                f"VRAGECAGE_LAB_CONTROLLER_ID={command_spec.get('controller_id', '')}",
                f"VRAGECAGE_LAB_DISTANCE={command_spec.get('distance_meters', '')}",
                f"VRAGECAGE_LAB_MAX_SPEED={command_spec.get('max_speed', '')}",
                f"VRAGECAGE_LAB_TIMEOUT_TICKS={command_spec.get('timeout_ticks', '')}",
            ])
    kill_signal = "SIGTERM" if engine == "magnetar" else "SIGINT"
    command = [
        "systemd-run", "--user", "--unit", unit.removesuffix(".service"), "--collect",
        "--property=Description=VRageCage isolated Space Engineers worker",
        f"--property=KillSignal={kill_signal}", "--property=TimeoutStopSec=60",
    ]
    for value in env_args:
        command.append(f"--setenv={value}")
    runner = "run-magnetar.sh" if engine == "magnetar" else "run-server.sh"
    command.extend([script(runner), args.instance])
    status = run_checked(command)
    if status == 0:
        emit({"schema": "vragecage.operation.v1", "operation": "run", "instance": args.instance, "engine": engine, "status": "starting", "unit": unit})
    return status


def command_stop(args: argparse.Namespace) -> int:
    env = os.environ.copy()
    env["VRAGECAGE_WORKER_ROOT"] = str(worker_root())
    engine = instance_engine(args.instance)
    stopper = "stop-magnetar.sh" if engine == "magnetar" else "stop-server.sh"
    stop_status = run_checked([script(stopper), args.instance], env=env)
    unit = unit_name(args.instance)
    subprocess.run(["systemctl", "--user", "stop", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    receipt, _ = read_receipt(args.instance)
    quarantine_receipt = persist_quarantine_receipt(args.instance, receipt)
    emit({"schema": "vragecage.operation.v1", "operation": "stop", "instance": args.instance,
          "status": "stopped" if stop_status == 0 else "stop_failed", "receipt": receipt,
          "quarantine_receipt": quarantine_receipt})
    return stop_status


def command_status(args: argparse.Namespace) -> int:
    unit = unit_name(args.instance)
    result = subprocess.run(
        ["systemctl", "--user", "show", unit, "--property=LoadState,ActiveState,SubState,Result,ExecMainStatus,NRestarts", "--output=json"],
        text=True, capture_output=True,
    )
    service: dict[str, object]
    try:
        service = json.loads(result.stdout) if result.stdout.strip() else {"LoadState": "not-found"}
    except json.JSONDecodeError:
        service = {
            key: value
            for line in result.stdout.splitlines()
            if "=" in line
            for key, value in [line.split("=", 1)]
        }
    receipt, _ = read_receipt(args.instance)
    emit({"schema": "vragecage.status.v1", "instance": args.instance, "service": service, "receipt": receipt})
    return 0


def command_receipt(args: argparse.Namespace) -> int:
    receipt, status = read_receipt(args.instance)
    if receipt is not None:
        emit(receipt)
    return status


def command_wait(args: argparse.Namespace) -> int:
    deadline = time.monotonic() + args.timeout
    unit = unit_name(args.instance)
    while time.monotonic() < deadline:
        receipt, _ = read_receipt(args.instance)
        observation_count = len(receipt.get("observations", [])) if receipt is not None and isinstance(receipt.get("observations"), list) else 0
        observations = receipt.get("observations", []) if receipt is not None and isinstance(receipt.get("observations"), list) else []
        requirements_met = all(
            any(requirement in observation for observation in observations if isinstance(observation, str))
            for requirement in args.require_observation
        )
        if receipt is not None and receipt.get("passed") is True and observation_count >= args.observations and requirements_met:
            emit(receipt)
            return 0
        state = subprocess.run(
            ["systemctl", "--user", "is-active", "--quiet", unit]
        ).returncode
        if state != 0:
            emit(
                {
                    "schema": "vragecage.operation.v1",
                    "operation": "wait",
                    "instance": args.instance,
                    "status": "stopped_before_ready",
                    "receipt": receipt,
                }
            )
            return 1
        time.sleep(1)
    emit(
        {
            "schema": "vragecage.operation.v1",
            "operation": "wait",
            "instance": args.instance,
                "status": "timeout",
                "timeout_seconds": args.timeout,
                "required_observations": args.observations,
                "required_observation_substrings": args.require_observation,
        }
    )
    return 1


def command_smoke(args: argparse.Namespace) -> int:
    env = os.environ.copy()
    env["VRAGECAGE_WORKER_ROOT"] = str(worker_root())
    env["VRAGECAGE_STARTUP_TIMEOUT"] = str(args.timeout)
    if args.reprepare:
        env["VRAGECAGE_REPREPARE_INSTANCE"] = "1"
    return run_checked([script("smoke-test.sh"), args.instance], env=env)


def instance_is_active(instance: str) -> bool:
    return subprocess.run(
        ["systemctl", "--user", "is-active", "--quiet", unit_name(instance)],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    ).returncode == 0


def command_register_mod(args: argparse.Namespace) -> int:
    if instance_is_active(args.instance):
        raise SystemExit(f"refusing to stage a mod while instance is running: {args.instance}")
    instance = instance_path(args.instance)
    engine = instance_engine(args.instance)
    registrar = "register-magnetar-mod.py" if engine == "magnetar" else "register-mod.py"
    argv = [script(registrar), str(instance), args.mod_name, args.source]
    if args.replace:
        argv.append("--replace")
    status = run_checked(argv)
    if status == 0:
        emit({"schema": "vragecage.operation.v1", "operation": "register_mod", "instance": args.instance, "engine": engine, "mod_name": args.mod_name, "status": "registered"})
    return status


def command_register_plugin(args: argparse.Namespace) -> int:
    if instance_is_active(args.instance):
        raise SystemExit(f"refusing to stage a plugin while instance is running: {args.instance}")
    argv = [script("register-magnetar-plugin.py"), str(instance_path(args.instance)), args.plugin_id, args.source]
    if args.replace:
        argv.append("--replace")
    status = run_checked(argv)
    if status == 0:
        emit({"schema": "vragecage.operation.v1", "operation": "register_plugin",
              "instance": args.instance, "plugin_id": args.plugin_id, "status": "registered"})
    return status


def command_import_world(args: argparse.Namespace) -> int:
    env = os.environ.copy()
    env["VRAGECAGE_WORKER_ROOT"] = str(worker_root())
    env["VRAGECAGE_BIND_IP"] = "0.0.0.0" if args.engine_ready else "127.0.0.1"
    if args.engine_ready:
        env["VRAGECAGE_ALLOW_NON_LOOPBACK"] = "1"
    argv = [script("import-world.py"), args.instance, args.source, "--engine", args.engine]
    if args.destructive_lab:
        argv.append("--destructive-lab")
    return run_checked(argv, env=env)


def command_lab_drive(args: argparse.Namespace) -> int:
    if subprocess.run(
        ["systemctl", "--user", "is-active", "--quiet", unit_name(args.instance)],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    ).returncode == 0:
        raise SystemExit(f"refusing to plan a lab command while instance is running: {args.instance}")
    return run_checked([
        script("lab-contract.py"), "plan-drive", str(instance_path(args.instance)),
        str(args.controller_id), "--distance", str(args.distance),
        "--max-speed", str(args.max_speed), "--timeout-ticks", str(args.timeout_ticks),
    ])


def command_fixture_inspect(args: argparse.Namespace) -> int:
    return run_checked([
        script("fixture-contract.py"), "inspect", str(instance_path(args.instance)),
    ])


def command_fixture_opt_in(args: argparse.Namespace) -> int:
    if instance_is_active(args.instance):
        raise SystemExit(f"refusing to edit a fixture while instance is running: {args.instance}")
    argv = [
        script("fixture-contract.py"), "opt-in-voidwright",
        str(instance_path(args.instance)), str(args.controller_id),
    ]
    if args.label:
        argv.extend(["--label", args.label])
    return run_checked(argv)


def worker_main(args: argparse.Namespace) -> int:
    commands = {
        "doctor": command_doctor,
        "prepare": command_prepare,
        "run": command_run,
        "stop": command_stop,
        "status": command_status,
        "receipt": command_receipt,
        "wait": command_wait,
        "smoke": command_smoke,
        "register-mod": command_register_mod,
        "register-plugin": command_register_plugin,
        "import-world": command_import_world,
        "lab-drive": command_lab_drive,
        "fixture-inspect": command_fixture_inspect,
        "fixture-opt-in": command_fixture_opt_in,
    }
    return commands[args.command](args)


def client_main(args: argparse.Namespace) -> int:
    if args.local:
        return worker_main(args)
    host = args.host or configured_host()
    if host is None:
        raise SystemExit(
            "worker target required: pass --host, set VRAGECAGE_HOST, or configure ~/.config/vragecage/config.json"
        )
    if args.command in ("stage-mod", "stage-world", "stage-plugin"):
        source = Path(args.path).resolve()
        if not source.is_dir():
            raise SystemExit(f"source directory does not exist: {source}")
        if args.command == "stage-mod" and not (source / "Data").is_dir():
            raise SystemExit(f"mod package has no Data directory: {source}")
        if args.command == "stage-plugin" and (
            len(list(source.glob("*.xml"))) != 1 or not (source / "vragecage.plugin.json").is_file()
        ):
            raise SystemExit("plugin source requires one root XML manifest and vragecage.plugin.json")
        if args.command == "stage-world":
            for required in ("Sandbox.sbc", "Sandbox_config.sbc", "SANDBOX_0_0_0_.sbs"):
                if not (source / required).is_file():
                    raise SystemExit(f"world is missing required file: {required}")
        validate_upload_tree(source)
        label = args.mod_name if args.command == "stage-mod" else args.plugin_id if args.command == "stage-plugin" else "world"
        incoming = f".local/share/vragecage-worker/incoming/{args.instance}-{label}-{uuid.uuid4().hex}"
        create = f"mkdir -p {shlex.quote(incoming)}"
        if subprocess.run(["ssh", "-F", "/dev/null", host, create]).returncode != 0:
            return 1
        try:
            producer = subprocess.Popen(["tar", "-C", str(source), "-cf", "-", "."], stdout=subprocess.PIPE)
            assert producer.stdout is not None
            extract = f"tar --no-same-owner --no-same-permissions -C {shlex.quote(incoming)} -xf -"
            consumer = subprocess.run(["ssh", "-F", "/dev/null", host, extract], stdin=producer.stdout)
            producer.stdout.close()
            producer_status = producer.wait()
            if producer_status != 0 or consumer.returncode != 0:
                return 1
            if args.command == "stage-mod":
                forwarded = ["_worker", "register-mod", args.instance, args.mod_name, f"~/{incoming}"]
                if args.replace:
                    forwarded.append("--replace")
            elif args.command == "stage-plugin":
                forwarded = ["_worker", "register-plugin", args.instance, args.plugin_id, f"~/{incoming}"]
                if args.replace:
                    forwarded.append("--replace")
            else:
                forwarded = ["_worker", "import-world", args.instance, f"~/{incoming}", "--engine", args.engine]
                if args.engine_ready:
                    forwarded.append("--engine-ready")
                if args.destructive_lab:
                    forwarded.append("--destructive-lab")
            remote = f"python3 ~/{REMOTE_CLI} {shlex.join(forwarded)}"
            return subprocess.run(["ssh", "-F", "/dev/null", host, remote]).returncode
        finally:
            # The upload path is generated locally beneath the worker's dedicated
            # incoming directory. Always remove it, including failed extractions.
            cleanup = f"rm -rf -- {shlex.quote(incoming)}"
            subprocess.run(["ssh", "-F", "/dev/null", host, cleanup],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    forwarded = ["_worker", args.command]
    if hasattr(args, "instance"):
        forwarded.append(args.instance)
    if getattr(args, "engine_ready", False):
        forwarded.append("--engine-ready")
    if hasattr(args, "engine"):
        forwarded.extend(["--engine", args.engine])
    if getattr(args, "reprepare", False):
        forwarded.append("--reprepare")
    if hasattr(args, "timeout"):
        forwarded.extend(["--timeout", str(args.timeout)])
    if hasattr(args, "observations"):
        forwarded.extend(["--observations", str(args.observations)])
    for requirement in getattr(args, "require_observation", []):
        forwarded.extend(["--require-observation", requirement])
    if args.command == "lab-drive":
        forwarded.extend([
            str(args.controller_id), "--distance", str(args.distance),
            "--max-speed", str(args.max_speed), "--timeout-ticks", str(args.timeout_ticks),
        ])
    if args.command == "fixture-opt-in":
        forwarded.append(str(args.controller_id))
        if args.label:
            forwarded.extend(["--label", args.label])
    remote = f"python3 ~/{REMOTE_CLI} {shlex.join(forwarded)}"
    return subprocess.run(["ssh", "-F", "/dev/null", host, remote]).returncode


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="vragecage", description="Deterministic and real-engine Space Engineers test runner")
    result.add_argument("--host", help="worker SSH target (or use VRAGECAGE_HOST/config.json)")
    result.add_argument("--local", action="store_true", help="operate on the current host instead of SSH")
    subparsers = result.add_subparsers(dest="command", required=True)
    doctor = subparsers.add_parser("doctor", help="verify worker prerequisites")
    doctor.add_argument("--engine", choices=ENGINES, default="proton")
    prepare = subparsers.add_parser("prepare", help="create a guarded disposable instance")
    prepare.add_argument("instance", type=validate_instance)
    prepare.add_argument("--engine", choices=ENGINES, default="proton")
    prepare.add_argument("--engine-ready", action="store_true", help="opt into the non-loopback bind required by Steamworks")
    prepare.add_argument("--reprepare", action="store_true", help="allow overlaying an existing instance")
    for name, help_text in (
        ("run", "start a prepared instance as a user service"),
        ("stop", "gracefully save and stop an instance"),
        ("status", "show service state and latest receipt"),
        ("receipt", "print the latest hashed server receipt"),
    ):
        command = subparsers.add_parser(name, help=help_text)
        command.add_argument("instance", type=validate_instance)
    wait = subparsers.add_parser("wait", help="wait for a persistent instance to become ready")
    wait.add_argument("instance", type=validate_instance)
    wait.add_argument("--timeout", type=int, default=180)
    wait.add_argument("--observations", type=int, choices=range(0, 33), default=0,
                      help="require at least this many deduplicated contract observations")
    wait.add_argument("--require-observation", action="append", default=[],
                      type=validate_observation_requirement,
                      help="require a substring in at least one observation; repeatable")
    smoke = subparsers.add_parser("smoke", help="prepare, boot, verify, and stop a disposable instance")
    smoke.add_argument("instance", type=validate_instance)
    smoke.add_argument("--timeout", type=int, default=180)
    smoke.add_argument("--reprepare", action="store_true")
    stage = subparsers.add_parser("stage-mod", help="atomically copy and register a local mod package")
    stage.add_argument("instance", type=validate_instance)
    stage.add_argument("path")
    stage.add_argument("--name", dest="mod_name", required=True, type=validate_instance)
    stage.add_argument("--replace", action="store_true")
    plugin = subparsers.add_parser("stage-plugin", help="atomically copy and register a Magnetar lab plugin")
    plugin.add_argument("instance", type=validate_instance)
    plugin.add_argument("path")
    plugin.add_argument("--id", dest="plugin_id", required=True, type=validate_instance)
    plugin.add_argument("--replace", action="store_true")
    world = subparsers.add_parser("stage-world", help="copy a local save into a new guarded instance")
    world.add_argument("instance", type=validate_instance)
    world.add_argument("path")
    world.add_argument("--engine", choices=ENGINES, default="magnetar")
    world.add_argument("--engine-ready", action="store_true", help="opt into the non-loopback bind required by Steamworks")
    world.add_argument("--destructive-lab", action="store_true", help="grant universal harness authority inside this disposable copy")
    register = subparsers.add_parser("register-mod", help=argparse.SUPPRESS)
    register.add_argument("instance", type=validate_instance)
    register.add_argument("mod_name", type=validate_instance)
    register.add_argument("source")
    register.add_argument("--replace", action="store_true")
    register_plugin = subparsers.add_parser("register-plugin", help=argparse.SUPPRESS)
    register_plugin.add_argument("instance", type=validate_instance)
    register_plugin.add_argument("plugin_id", type=validate_instance)
    register_plugin.add_argument("source")
    register_plugin.add_argument("--replace", action="store_true")
    import_world = subparsers.add_parser("import-world", help=argparse.SUPPRESS)
    import_world.add_argument("instance", type=validate_instance)
    import_world.add_argument("source")
    import_world.add_argument("--engine", choices=ENGINES, required=True)
    import_world.add_argument("--engine-ready", action="store_true")
    import_world.add_argument("--destructive-lab", action="store_true")

    drive = subparsers.add_parser("lab-drive", help="queue one bounded destructive-lab drive command")
    drive.add_argument("instance", type=validate_instance)
    drive.add_argument("controller_id", type=int)
    drive.add_argument("--distance", type=float, default=3.0)
    drive.add_argument("--max-speed", type=float, default=2.0)
    drive.add_argument("--timeout-ticks", type=int, default=600)
    fixture_inspect = subparsers.add_parser(
        "fixture-inspect", help="inspect grids, Remote Controls, and GPS targets in a lab fixture"
    )
    fixture_inspect.add_argument("instance", type=validate_instance)
    fixture_opt_in = subparsers.add_parser(
        "fixture-opt-in", help="opt one copied-world Remote Control into Voidwright"
    )
    fixture_opt_in.add_argument("instance", type=validate_instance)
    fixture_opt_in.add_argument("controller_id", type=int)
    fixture_opt_in.add_argument("--label", type=validate_observation_requirement)
    return result


def main() -> int:
    worker_mode = len(sys.argv) > 1 and sys.argv[1] == "_worker"
    argv = sys.argv[2:] if worker_mode else sys.argv[1:]
    args = parser().parse_args(argv)
    if worker_mode:
        return worker_main(args)
    return client_main(args)


if __name__ == "__main__":
    raise SystemExit(main())
