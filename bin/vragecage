def command_passive_telemetry_export(args: argparse.Namespace) -> int:
    jsonl, summary, _ = collect_passive_telemetry(args.instance, args.run_id)
    if args.stream:
        write_passive_telemetry_envelope(sys.stdout.buffer, args.run_id, jsonl, summary)
        sys.stdout.buffer.flush()
    else:
        emit({"schema": "vragecage.passive-telemetry-export.v1", "instance": args.instance,
              "run_id": args.run_id, "status": "verified", "jsonl_size_bytes": len(jsonl),
              "summary_size_bytes": len(summary)})
    return 0


def command_passive_telemetry_status(args: argparse.Namespace) -> int:
    return run_checked([script("passive-telemetry-contract.py"), "status",
                        str(instance_path(args.instance))])


def client_passive_telemetry_export(args: argparse.Namespace, host: str | None) -> int:
    if args.local:
        jsonl, summary, metadata = collect_passive_telemetry(args.instance, args.run_id)
    else:
        assert host is not None
        forwarded = ["_worker", "passive-telemetry-export", args.instance, args.run_id, "--stream"]
        remote = f"python3 ~/{REMOTE_CLI} {shlex.join(forwarded)}"
        process = subprocess.Popen(["ssh", "-F", "/dev/null", host, remote], stdout=subprocess.PIPE)
        assert process.stdout is not None
        try:
            jsonl, summary = read_passive_telemetry_envelope(process.stdout, args.run_id)
        except BaseException:
            process.terminate()
            process.wait()
            raise
        return_code = process.wait()
        if return_code != 0:
            raise SystemExit(f"worker passive telemetry export failed with status {return_code}")
        summary_value = _load_passive_json(summary, "summary")
        metadata = _validate_passive_capture(jsonl, summary_value, args.run_id)
        metadata["jsonl_sha256"] = hashlib.sha256(jsonl).hexdigest()
        metadata["summary_sha256"] = hashlib.sha256(summary).hexdigest()
        metadata["jsonl_size_bytes"] = len(jsonl)
        metadata["summary_size_bytes"] = len(summary)

    output_paths = store_passive_telemetry(Path(args.output_dir), args.run_id, jsonl, summary)
    emit({"schema": "vragecage.passive-telemetry-export.v1", "instance": args.instance,
          "status": "verified", **metadata, "output_paths": output_paths, "server_source_modified": False})
    return 0


def worker_main(args: argparse.Namespace) -> int:
    commands = {
        "doctor": command_doctor,
        "prepare": command_prepare,
        "run": command_run,
        "stop": command_stop,
        "status": command_status,
        "receipt": command_receipt,
        "wait": command_wait,
        "smoke": command_smoke,
        "register-mod": command_register_mod,
        "register-plugin": command_register_plugin,
        "register-passive-telemetry-plugin": command_register_passive_telemetry_plugin,
        "import-world": command_import_world,
        "lab-drive": command_lab_drive,
        "local-vehicle-command": command_local_vehicle_command,
        "lab-direct-maneuver": command_lab_direct_maneuver,
        "lab-preflight-only": command_lab_preflight_only,
        "lab-command-activate": command_lab_command_activate,
        "lab-zero-hold-activate": command_lab_zero_hold_activate,
        "lab-sensor-frame": command_lab_sensor_frame,
        "lab-rotate-stator": command_lab_rotate_stator,
        "lab-play-recorder": command_lab_play_recorder,
        "lab-follow-recorder": command_lab_follow_recorder,
        "lab-drive-zone": command_lab_drive_zone,
        "fixture-inspect": command_fixture_inspect,
        "lab-trial": command_lab_trial,
        "lab-trial-status": command_lab_trial_status,
        "fixture-opt-in": command_fixture_opt_in,
        "passive-telemetry-export": command_passive_telemetry_export,
        "passive-telemetry-status": command_passive_telemetry_status,
    }
    if args.command in ("run", "stop", "lab-command-activate", "lab-zero-hold-activate"):
        instance = instance_path(args.instance)
        if instance.is_symlink() or not instance.is_dir():
            raise SystemExit("lifecycle operations require an existing non-symlink instance")
        descriptor = os.open(instance / ".vragecage-lifecycle.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
        with os.fdopen(descriptor, "a+b") as lock:
            if not stat.S_ISREG(os.fstat(lock.fileno()).st_mode):
                raise SystemExit("lifecycle lock must be a regular file")
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                emit({"schema": "vragecage.operation.v1", "operation": args.command, "instance": args.instance, "status": "lifecycle_busy"})
                return 75
            return commands[args.command](args)
    return commands[args.command](args)


def client_main(args: argparse.Namespace) -> int:
    if args.command == "passive-telemetry-export":
        host = None if args.local else args.host or configured_host()
        if not args.local and host is None:
            raise SystemExit("worker target required: pass --host, set VRAGECAGE_HOST, or configure ~/.config/vragecage/config.json")
        return client_passive_telemetry_export(args, host)
    if args.command == "stage-passive-telemetry" and args.local:
        return command_register_passive_telemetry_plugin(args)
    if args.local:
        return worker_main(args)
    host = args.host or configured_host()
    if host is None:
        raise SystemExit(
            "worker target required: pass --host, set VRAGECAGE_HOST, or configure ~/.config/vragecage/config.json"
        )
    if args.command in ("stage-mod", "stage-world", "stage-plugin", "stage-passive-telemetry", "import-world"):
        source_arg = args.source if args.command == "import-world" else args.path
        source = Path(source_arg).resolve()
        if not source.is_dir():
            raise SystemExit(f"source directory does not exist: {source}")
        if args.command == "stage-mod" and not (source / "Data").is_dir():
            raise SystemExit(f"mod package has no Data directory: {source}")
        if args.command == "stage-plugin" and (
            len(list(source.glob("*.xml"))) != 1 or not (source / "vragecage.plugin.json").is_file()
        ):
            raise SystemExit("plugin source requires one root XML manifest and vragecage.plugin.json")
        if args.command == "stage-passive-telemetry" and (
            len(list(source.glob("*.xml"))) != 1 or
            not (source / "vragecage.passive-telemetry-plugin.json").is_file()
        ):
            raise SystemExit("passive telemetry source requires its root manifest and read-only package contract")
        if args.command in ("stage-world", "import-world"):
            for required in ("Sandbox.sbc", "Sandbox_config.sbc", "SANDBOX_0_0_0_.sbs"):
                if not (source / required).is_file():
                    raise SystemExit(f"world is missing required file: {required}")
        validate_upload_tree(source)
        label = args.mod_name if args.command == "stage-mod" else args.plugin_id if args.command == "stage-plugin" else "voidwright-passive-telemetry" if args.command == "stage-passive-telemetry" else "world"
        incoming = f".local/share/vragecage-worker/incoming/{args.instance}-{label}-{uuid.uuid4().hex}"
        create = f"mkdir -p {shlex.quote(incoming)}"
        if subprocess.run(["ssh", "-F", "/dev/null", host, create]).returncode != 0:
            return 1
        try:
            producer = subprocess.Popen(["tar", "-C", str(source), "-cf", "-", "."], stdout=subprocess.PIPE)
            assert producer.stdout is not None
            extract = f"tar --no-same-owner --no-same-permissions -C {shlex.quote(incoming)} -xf -"
            consumer = subprocess.run(["ssh", "-F", "/dev/null", host, extract], stdin=producer.stdout)
            producer.stdout.close()
            producer_status = producer.wait()
            if producer_status != 0 or consumer.returncode != 0:
                return 1
            if args.command == "stage-mod":
                forwarded = ["_worker", "register-mod", args.instance, args.mod_name, f"~/{incoming}"]
                if args.replace:
                    forwarded.append("--replace")
            elif args.command == "stage-plugin":
                forwarded = ["_worker", "register-plugin", args.instance, args.plugin_id, f"~/{incoming}"]
                if args.replace:
                    forwarded.append("--replace")
            elif args.command == "stage-passive-telemetry":
                forwarded = ["_worker", "register-passive-telemetry-plugin", args.instance,
                             f"~/{incoming}"]
                if args.replace:
                    forwarded.append("--replace")
            elif args.command == "stage-world":
                forwarded = ["_worker", "import-world", args.instance, f"~/{incoming}", "--engine", args.engine]
                if args.engine_ready:
                    forwarded.append("--engine-ready")
                if args.destructive_lab:
                    forwarded.append("--destructive-lab")
            else:
                forwarded = ["_worker", "import-world", args.instance, f"~/{incoming}",
                             "--engine", args.engine]
                if args.engine_ready:
                    forwarded.append("--engine-ready")
                if args.destructive_lab:
                    forwarded.append("--destructive-lab")
            remote = f"python3 ~/{REMOTE_CLI} {shlex.join(forwarded)}"
            return subprocess.run(["ssh", "-F", "/dev/null", host, remote]).returncode
        finally:
            # The upload path is generated locally beneath the worker's dedicated
            # incoming directory. Always remove it, including failed extractions.
            cleanup = f"rm -rf -- {shlex.quote(incoming)}"
            subprocess.run(["ssh", "-F", "/dev/null", host, cleanup],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    forwarded = ["_worker", args.command]
    if hasattr(args, "instance"):
        forwarded.append(args.instance)
    if getattr(args, "engine_ready", False):
        forwarded.append("--engine-ready")
    if hasattr(args, "engine"):
        forwarded.extend(["--engine", args.engine])
    if getattr(args, "reprepare", False):
        forwarded.append("--reprepare")
    if hasattr(args, "timeout"):
        forwarded.extend(["--timeout", str(args.timeout)])
    if args.command == "lab-command-activate":
        forwarded.extend(["--wait-seconds", str(args.wait_seconds)])
    if hasattr(args, "observations"):
        forwarded.extend(["--observations", str(args.observations)])
    for requirement in getattr(args, "require_observation", []):
        forwarded.extend(["--require-observation", requirement])
    if args.command == "lab-drive":
        forwarded.extend([
            str(args.controller_id), "--distance", str(args.distance),
            "--max-speed", str(args.max_speed), "--timeout-ticks", str(args.timeout_ticks),
        ])
        if args.reverse:
            forwarded.append("--reverse")
    if args.command == "local-vehicle-command":
        forwarded.extend([args.kind, "--value", str(args.value), "--max-speed", str(args.max_speed),
                          "--steering", str(args.steering), "--ttl-seconds", str(args.ttl_seconds)])
    if args.command == "lab-direct-maneuver":
        forwarded.extend([str(args.controller_id), str(args.grid_id), str(args.camera_id)])
        for segment in args.segment:
            forwarded.extend(["--segment", segment])
    if args.command == "lab-preflight-only":
        forwarded.extend([str(args.controller_id), str(args.grid_id), str(args.camera_id),
                          "--max-speed", str(args.max_speed), "--timeout-ticks", str(args.timeout_ticks)])
    if args.command == "lab-sensor-frame":
        forwarded.extend([
            str(args.camera_id), "--width", str(args.width), "--height", str(args.height),
            "--range", str(args.range_meters), "--fov", str(args.fov_degrees),
        ])
    if args.command == "lab-rotate-stator":
        forwarded.extend([
            str(args.stator_id), str(args.camera_id), args.expected_name,
            str(args.desired_angle_degrees), "--max-rpm", str(args.max_rpm),
            "--timeout-ticks", str(args.timeout_ticks),
        ])
    if args.command == "lab-play-recorder":
        forwarded.extend([
            str(args.controller_id), str(args.recorder_id),
            "--duration-ticks", str(args.duration_ticks),
        ])
    if args.command == "lab-follow-recorder":
        forwarded.extend([
            str(args.controller_id), str(args.recorder_id), "--max-speed", str(args.max_speed),
            "--arrival-radius", str(args.arrival_radius), "--timeout-ticks", str(args.timeout_ticks),
        ])
    if args.command == "lab-drive-zone":
        depth_mode = args.depth_camera_id is not None
        max_speed = args.max_speed if args.max_speed is not None else (0.5 if depth_mode else 1.0)
        timeout_ticks = args.timeout_ticks if args.timeout_ticks is not None else (900 if depth_mode else 1800)
        forwarded.extend([
            str(args.controller_id), args.zone, "--max-speed", str(max_speed),
            "--arrival-radius", str(args.arrival_radius),
            "--timeout-ticks", str(timeout_ticks), "--offset-left", str(args.offset_left),
        ])
        if depth_mode:
            forwarded.extend(["--depth-camera-id", str(args.depth_camera_id)])
        if args.start_delay_ticks:
            forwarded.extend(["--start-delay-ticks", str(args.start_delay_ticks)])
    if args.command == "fixture-opt-in":
        forwarded.append(str(args.controller_id))
        if args.label:
            forwarded.extend(["--label", args.label])
    if args.command == "lab-trial":
        for name in ("fixture_id", "request_id", "controller_id", "depth_camera_id", "target", "snapshot_relative_path", "grid_name"):
            forwarded.extend(["--" + name.replace("_", "-"), str(getattr(args, name))])
        if args.execute:
            forwarded.extend(["--execute", "--expect-plan-sha256", args.expect_plan_sha256])
    if args.command == "lab-trial-status":
        forwarded.extend(["--fixture-id", args.fixture_id, "--request-id", args.request_id])
    if args.command == "run" and args.expected_operation_id is not None:
        forwarded.extend(["--expected-operation-id", args.expected_operation_id, "--expected-command-sha256", args.expected_command_sha256])
    if args.command == "run" and args.discovery_only:
        forwarded.append("--discovery-only")
    if args.command == "run" and args.motion_telemetry_interval_ticks is not None:
        forwarded.extend(["--motion-telemetry-interval-ticks", str(args.motion_telemetry_interval_ticks)])
    if args.command == "stop" and args.expected_run_id is not None:
        forwarded.extend(["--expected-run-id", args.expected_run_id])
    remote = f"python3 ~/{REMOTE_CLI} {shlex.join(forwarded)}"
    return subprocess.run(["ssh", "-F", "/dev/null", host, remote]).returncode


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="vragecage", description="Deterministic and real-engine Space Engineers test runner")
    result.add_argument("--host", help="worker SSH target (or use VRAGECAGE_HOST/config.json)")
    result.add_argument("--local", action="store_true", help="operate on the current host instead of SSH")
    subparsers = result.add_subparsers(dest="command", required=True)
    doctor = subparsers.add_parser("doctor", help="verify worker prerequisites")
    doctor.add_argument("--engine", choices=ENGINES, default="proton")
    prepare = subparsers.add_parser("prepare", help="create a guarded disposable instance")
    prepare.add_argument("instance", type=validate_instance)
    prepare.add_argument("--engine", choices=ENGINES, default="proton")
    prepare.add_argument("--engine-ready", action="store_true", help="opt into the non-loopback bind required by Steamworks")
    prepare.add_argument("--reprepare", action="store_true", help="allow overlaying an existing instance")
    for name, help_text in (
        ("run", "start a prepared instance as a user service"),
        ("stop", "gracefully save and stop an instance"),
        ("status", "show service state and latest receipt"),
        ("receipt", "print the latest hashed server receipt"),
    ):
        command = subparsers.add_parser(name, help=help_text)
        command.add_argument("instance", type=validate_instance)
        if name == "run":
            command.add_argument("--discovery-only", action="store_true",
                                 help="start an isolated read-only discovery bootstrap for a later preflight activation")
            command.add_argument("--expected-operation-id")
            command.add_argument("--expected-command-sha256")
            command.add_argument("--motion-telemetry-interval-ticks", type=validate_motion_telemetry_interval,
                                 help="capture read-only motion telemetry every 1-600 simulation ticks; default 10")
        if name == "stop":
            command.add_argument("--expected-run-id")
    wait = subparsers.add_parser("wait", help="wait for a persistent instance to become ready")
    wait.add_argument("instance", type=validate_instance)
    wait.add_argument("--timeout", type=int, default=180)
    wait.add_argument("--observations", type=int, choices=range(0, 33), default=0,
                      help="require at least this many deduplicated contract observations")
    wait.add_argument("--require-observation", action="append", default=[],
                      type=validate_observation_requirement,
                      help="require a substring in at least one observation; repeatable")
    smoke = subparsers.add_parser("smoke", help="prepare, boot, verify, and stop a disposable instance")
    smoke.add_argument("instance", type=validate_instance)
    smoke.add_argument("--timeout", type=int, default=180)
    smoke.add_argument("--reprepare", action="store_true")
    stage = subparsers.add_parser("stage-mod", help="atomically copy and register a local mod package")
    stage.add_argument("instance", type=validate_instance)
    stage.add_argument("path")
    stage.add_argument("--name", dest="mod_name", required=True, type=validate_instance)
    stage.add_argument("--replace", action="store_true")
    plugin = subparsers.add_parser("stage-plugin", help="atomically copy and register a Magnetar lab plugin")
    plugin.add_argument("instance", type=validate_instance)
    plugin.add_argument("path")
    plugin.add_argument("--id", dest="plugin_id", required=True, type=validate_instance)
    plugin.add_argument("--replace", action="store_true")
    passive_stage = subparsers.add_parser(
        "stage-passive-telemetry",
        help="stage the separate read-only player-consented Driving Lab telemetry plugin",
    )
    passive_stage.add_argument("instance", type=validate_instance)
    passive_stage.add_argument("path")
    passive_stage.add_argument("--replace", action="store_true")
    world = subparsers.add_parser("stage-world", help="copy a local save into a new guarded instance")
    world.add_argument("instance", type=validate_instance)
    world.add_argument("path")
    world.add_argument("--engine", choices=ENGINES, default="magnetar")
    world.add_argument("--engine-ready", action="store_true", help="opt into the non-loopback bind required by Steamworks")
    world.add_argument("--destructive-lab", action="store_true", help="grant universal harness authority inside this disposable copy")
    register = subparsers.add_parser("register-mod", help=argparse.SUPPRESS)
    register.add_argument("instance", type=validate_instance)
    register.add_argument("mod_name", type=validate_instance)
    register.add_argument("source")
    register.add_argument("--replace", action="store_true")
    register_plugin = subparsers.add_parser("register-plugin", help=argparse.SUPPRESS)
    register_plugin.add_argument("instance", type=validate_instance)
    register_plugin.add_argument("plugin_id", type=validate_instance)
    register_plugin.add_argument("source")
    register_plugin.add_argument("--replace", action="store_true")
    register_passive = subparsers.add_parser("register-passive-telemetry-plugin", help=argparse.SUPPRESS)
    register_passive.add_argument("instance", type=validate_instance)
    register_passive.add_argument("source")
    register_passive.add_argument("--replace", action="store_true")
    import_world = subparsers.add_parser("import-world", help=argparse.SUPPRESS)
    import_world.add_argument("instance", type=validate_instance)
    import_world.add_argument("source")
    import_world.add_argument("--engine", choices=ENGINES, required=True)
    import_world.add_argument("--engine-ready", action="store_true")
    import_world.add_argument("--destructive-lab", action="store_true")

    drive = subparsers.add_parser("lab-drive", help="queue one bounded destructive-lab drive command")
    drive.add_argument("instance", type=validate_instance)
    drive.add_argument("controller_id", type=int)
    drive.add_argument("--distance", type=float, default=3.0)
    drive.add_argument("--max-speed", type=float, default=2.0)
    drive.add_argument("--timeout-ticks", type=int, default=600)
    drive.add_argument("--reverse", action="store_true",
                       help="back up at no more than 0.5 m/s for at most 3 meters")
    local_command = subparsers.add_parser(
        "local-vehicle-command", help="queue one short run-bound command on the exact disposable Blue Truck")
    local_command.add_argument("instance", type=validate_instance)
    local_command.add_argument("kind", choices=("drive", "brake", "neutral"))
    local_command.add_argument("--value", type=float, default=0.03,
                                help="forward propulsion override, capped at 0.03")
    local_command.add_argument("--max-speed", type=float, default=0.1)
    local_command.add_argument("--steering", type=float, default=0.0)
    local_command.add_argument("--ttl-seconds", type=int, default=10)
    maneuver = subparsers.add_parser(
        "lab-direct-maneuver", help="queue a composed, bounded planner-independent Voidwright maneuver"
    )
    maneuver.add_argument("instance", type=validate_instance)
    maneuver.add_argument("controller_id", type=int, nargs="?")
    maneuver.add_argument("grid_id", type=int, nargs="?")
    maneuver.add_argument("camera_id", type=int, nargs="?")
    maneuver.add_argument("--segment", action="append", required=True,
                          help="kind:value:max-speed:timeout-ticks; repeat up to 12 times in sequence order")
    preflight = subparsers.add_parser("lab-preflight-only", help="collect exact host and mod preflight without actuator dispatch")
    preflight.add_argument("instance", type=validate_instance)
    preflight.add_argument("controller_id", type=int, nargs="?")
    preflight.add_argument("grid_id", type=int, nargs="?")
    preflight.add_argument("camera_id", type=int, nargs="?")
    preflight.add_argument("--max-speed", type=float, default=0.8)
    preflight.add_argument("--timeout-ticks", type=int, default=300)
    stage_two = subparsers.add_parser("lab-command-activate", help="activate one preflight-only command from current same-session discovery")
    stage_two.add_argument("instance", type=validate_instance)
    stage_two.add_argument("--wait-seconds", type=int, default=45)
    zero_hold = subparsers.add_parser("lab-zero-hold-activate", help="activate one fixed zero-only stationary hold from current same-session discovery")
    zero_hold.add_argument("instance", type=validate_instance)
    zero_hold.add_argument("--wait-seconds", type=int, default=45)
    sensor = subparsers.add_parser(
        "lab-sensor-frame", help="queue one bounded server-side depth sensor frame"
    )
    sensor.add_argument("instance", type=validate_instance)
    sensor.add_argument("camera_id", type=int)
    sensor.add_argument("--width", type=int, default=32)
    sensor.add_argument("--height", type=int, default=18)
    sensor.add_argument("--range", dest="range_meters", type=float, default=150.0)
    sensor.add_argument("--fov", dest="fov_degrees", type=float, default=70.0)
    rotate = subparsers.add_parser(
        "lab-rotate-stator", help="rotate one named, camera-bound stator in a disposable fixture"
    )
    rotate.add_argument("instance", type=validate_instance)
    rotate.add_argument("stator_id", type=int)
    rotate.add_argument("camera_id", type=int)
    rotate.add_argument("expected_name")
    rotate.add_argument("desired_angle_degrees", type=float)
    rotate.add_argument("--max-rpm", type=float, default=0.5)
    rotate.add_argument("--timeout-ticks", type=int, default=1800)
    recorded = subparsers.add_parser(
        "lab-play-recorder", help="play a saved Path Recorder route for a bounded simulation window"
    )
    recorded.add_argument("instance", type=validate_instance)
    recorded.add_argument("controller_id", type=int)
    recorded.add_argument("recorder_id", type=int)
    recorded.add_argument("--duration-ticks", type=int, default=600,
                          help="bounded playback window, 60-7200 simulation ticks")
    follow = subparsers.add_parser(
        "lab-follow-recorder", help="follow saved Path Recorder waypoints with bounded wheel guidance"
    )
    follow.add_argument("instance", type=validate_instance)
    follow.add_argument("controller_id", type=int)
    follow.add_argument("recorder_id", type=int)
    follow.add_argument("--max-speed", type=float, default=1.0)
    follow.add_argument("--arrival-radius", type=float, default=2.0)
    follow.add_argument("--timeout-ticks", type=int, default=7200)
    navigate = subparsers.add_parser(
        "lab-drive-zone", help="queue bounded wheel guidance to an exact fixture GPS zone"
    )
    navigate.add_argument("instance", type=validate_instance)
    navigate.add_argument("controller_id", type=int)
    navigate.add_argument("zone", type=validate_observation_requirement)
    navigate.add_argument("--max-speed", type=float)
    navigate.add_argument("--arrival-radius", type=float, default=2.0)
    navigate.add_argument("--timeout-ticks", type=int)
    navigate.add_argument("--offset-left", type=float, default=0,
                          help="offset target left of the controller's initial heading, -10 to 10 meters")
    navigate.add_argument("--depth-camera-id", type=int,
                          help="opt into the low-speed front-camera depth-guided controller")
    navigate.add_argument("--start-delay-ticks", type=int, default=0,
                          help="hold the rover stopped before depth-guided movement, up to 3600 simulation ticks")
    fixture_inspect = subparsers.add_parser(
        "fixture-inspect", help="inspect grids, Remote Controls, and GPS targets in a lab fixture"
    )
    fixture_inspect.add_argument("instance", type=validate_instance)
    fixture_opt_in = subparsers.add_parser(
        "fixture-opt-in", help="opt one copied-world Remote Control into Voidwright"
    )
    fixture_opt_in.add_argument("instance", type=validate_instance)
    fixture_opt_in.add_argument("controller_id", type=int)
    fixture_opt_in.add_argument("--label", type=validate_observation_requirement)
    trial = subparsers.add_parser("lab-trial", help="preview or execute one reviewed, idempotent bounded GPS trial")
    trial.add_argument("instance", type=validate_instance)
    for name in ("fixture-id", "request-id", "controller-id", "depth-camera-id", "target", "snapshot-relative-path", "grid-name"):
        trial.add_argument("--" + name, required=True)
    trial.add_argument("--execute", action="store_true")
    trial.add_argument("--expect-plan-sha256")
    trial_status = subparsers.add_parser("lab-trial-status", help="read a fixture-bound trial journal without replaying anything")
    trial_status.add_argument("instance", type=validate_instance)
    trial_status.add_argument("--fixture-id", required=True)
    trial_status.add_argument("--request-id", required=True)
    passive_export = subparsers.add_parser(
        "passive-telemetry-export",
        help="copy completed read-only Driving Lab telemetry from one exact disposable instance",
    )
    passive_export.add_argument("instance", type=validate_instance)
    passive_export.add_argument("run_id", type=validate_run_id)
    passive_export.add_argument("--output-dir",
                                help="local directory for the verified JSONL and summary copies")
    passive_export.add_argument("--stream", action="store_true", help=argparse.SUPPRESS)
    passive_status = subparsers.add_parser(
        "passive-telemetry-status",
        help="show the verified read-only telemetry contract and current Magnetar run ID",
    )
    passive_status.add_argument("instance", type=validate_instance)
    return result


def main() -> int:
    worker_mode = len(sys.argv) > 1 and sys.argv[1] == "_worker"
    argv = sys.argv[2:] if worker_mode else sys.argv[1:]
    args = parser().parse_args(argv)
    if args.command == "lab-trial" and bool(args.expect_plan_sha256) != args.execute:
        raise SystemExit("lab-trial requires --execute and --expect-plan-sha256 together")
    if args.command == "run" and (args.expected_operation_id is None) != (args.expected_command_sha256 is None):
        raise SystemExit("reviewed run requires both expected operation ID and command SHA256")
    if worker_mode:
        return worker_main(args)
    if args.command == "passive-telemetry-export":
        if args.stream:
            raise SystemExit("--stream is reserved for the internal worker transport")
        if not args.output_dir:
            raise SystemExit("passive-telemetry-export requires --output-dir")
    return client_main(args)


if __name__ == "__main__":
    raise SystemExit(main())
