    if status == 0:
        emit({"schema": "vragecage.operation.v1", "operation": "stage_passive_telemetry",
              "instance": args.instance, "plugin_id": "voidwright-passive-telemetry",
              "permission_scope": "read_only_observation", "status": "registered"})
    return status


def command_import_world(args: argparse.Namespace) -> int:
    env = os.environ.copy()
    env["VRAGECAGE_WORKER_ROOT"] = str(worker_root())
    env["VRAGECAGE_BIND_IP"] = "0.0.0.0" if args.engine_ready else "127.0.0.1"
    if args.engine_ready:
        env["VRAGECAGE_ALLOW_NON_LOOPBACK"] = "1"
    argv = [script("import-world.py"), args.instance, args.source, "--engine", args.engine]
    if args.destructive_lab:
        argv.append("--destructive-lab")
    return run_checked(argv, env=env)


def command_lab_drive(args: argparse.Namespace) -> int:
    if subprocess.run(
        ["systemctl", "--user", "is-active", "--quiet", unit_name(args.instance)],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    ).returncode == 0:
        raise SystemExit(f"refusing to plan a lab command while instance is running: {args.instance}")
    command = [
        script("lab-contract.py"), "plan-drive", str(instance_path(args.instance)),
        str(args.controller_id), "--distance", str(args.distance),
        "--max-speed", str(args.max_speed), "--timeout-ticks", str(args.timeout_ticks),
    ]
    if args.reverse:
        command.append("--reverse")
    return run_checked(command)


def command_local_vehicle_command(args: argparse.Namespace) -> int:
    instance = instance_path(args.instance)
    if args.instance != "land-local-test-v4r1-blue-20261022-a":
        raise SystemExit("local vehicle commands are restricted to the pinned Blue Truck clone")
    if not instance_is_active(args.instance):
        raise SystemExit("local vehicle command requires the exact test server to be active")
    try:
        config = json.loads((instance / ".vragecage-local-vehicle-test.json").read_text(encoding="utf-8"))
        active = json.loads((instance / ".vragecage-active-run.json").read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise SystemExit("local vehicle command lacks a valid run-bound fixture config") from error
    if (config.get("mode") != "isolated-clear" or config.get("propulsion_enabled") is not True or
            config.get("isolated_clear") is not True or active.get("instance") != args.instance or
            not re.fullmatch(r"[0-9a-f]{32}", str(active.get("run_id", ""))) or
            not re.fullmatch(r"[0-9a-f]{32}", str(active.get("fixture_id", "")))):
        raise SystemExit("local vehicle command requires a fresh movement-enabled exact-instance run")
    if args.kind == "drive":
        if (not math.isfinite(args.value) or not 0 <= args.value <= 0.03 or
                not math.isfinite(args.max_speed) or not 0 < args.max_speed <= config["max_speed_meters_per_second"] or
                not math.isfinite(args.steering) or abs(args.steering) > 0.20):
            raise SystemExit("drive command exceeds the 0.03 propulsion override, 0.20 steering override, or configured speed cap")
        if abs(args.steering) > 0.001:
            proof = config.get("steering_direction_proof")
            plugin_hash = config.get("current_plugin_tree_sha256")
            if proof is None or not isinstance(plugin_hash, str):
                raise SystemExit("combined steering and propulsion requires the validated steering direction proof")
            _validate_local_vehicle_direction_proof(instance, proof, plugin_hash)
            logs = sorted(instance.glob("SpaceEngineersDedicated_*.log"),
                          key=lambda path: path.stat().st_mtime, reverse=True)
            if not logs or logs[0].is_symlink():
                raise SystemExit("combined steering requires the current run's direction-proof activation log")
            current_log = logs[0].read_text(encoding="utf-8", errors="replace")
            if ("steeringDirectionProof=True" not in current_log or
                    "run=" + str(active["run_id"]) not in current_log):
                raise SystemExit("combined steering requires the current active run to have loaded the validated direction proof")
        value, speed, steering = args.value, args.max_speed, args.steering
    elif args.kind == "brake":
        value, speed, steering = 1.0, 0.0, 0.0
    else:
        value, speed, steering = 0.0, 0.0, 0.0
    if type(args.ttl_seconds) is not int or not 1 <= args.ttl_seconds <= 20:
        raise SystemExit("local vehicle command lifetime must be 1-20 seconds")
    issued = datetime.now(timezone.utc)
    expires = issued + timedelta(seconds=args.ttl_seconds)
    epoch = datetime(1, 1, 1, tzinfo=issued.tzinfo)
    def ticks(value: datetime) -> int:
        delta = value - epoch
        return ((delta.days * 86400 + delta.seconds) * 10_000_000 + delta.microseconds * 10)
    command_id = secrets.token_hex(16)
    fields = ["VWLC2", command_id, args.instance, str(active["run_id"]), str(active["fixture_id"]),
              str(config["grid_id"]), str(config["controller_id"]), args.kind,
              format(value, ".17g"), format(speed, ".17g"), format(steering, ".17g"),
              str(ticks(issued)), str(ticks(expires))]
    payload = ("|".join(fields) + "\n").encode("ascii")
    storage = _local_vehicle_world_storage(instance)
    command_path = storage / "voidwright-local-test-command-v1.txt"
    if command_path.is_file() and not command_path.is_symlink():
        try:
            existing = command_path.read_text(encoding="ascii")
        except OSError:
            existing = ""
        if existing.endswith("\n") and existing.split("|")[-1].strip().isdigit():
            if int(existing.split("|")[-1].strip()) > ticks(issued):
                raise SystemExit("an unexpired local vehicle command already occupies the mailbox")
    _write_mailbox_file(command_path, payload)
    emit({"schema": "vragecage.local-vehicle-command.v1", "instance": args.instance,
          "run_id": active["run_id"], "fixture_id": active["fixture_id"],
          "command_id": command_id, "kind": args.kind, "value": value,
          "max_speed_meters_per_second": speed, "expires_utc": expires.isoformat(),
          "mailbox_sha256": hashlib.sha256(payload).hexdigest()})
    return 0


def command_lab_direct_maneuver(args: argparse.Namespace) -> int:
    if instance_is_active(args.instance):
        raise SystemExit(f"refusing to plan a lab command while instance is running: {args.instance}")
    command = [script("lab-contract.py"), "plan-direct-maneuver", str(instance_path(args.instance))]
    if any(value is not None for value in (args.controller_id, args.grid_id, args.camera_id)):
        if any(value is None for value in (args.controller_id, args.grid_id, args.camera_id)):
            raise SystemExit("manual target IDs must be supplied together, or omitted for discovery")
        command.extend([str(args.controller_id), str(args.grid_id), str(args.camera_id)])
    for segment in args.segment:
        command.extend(["--segment", segment])
    return run_checked(command)


