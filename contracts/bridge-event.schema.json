{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yurei.so/vragecage/contracts/bridge-event.schema.json",
  "title": "VRageCage bridge event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation_id", "scenario_id", "sequence", "tick", "event"],
  "properties": {
    "schema": { "const": "vragecage.bridge-event/v1" },
    "operation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "scenario_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sequence": { "type": "integer", "minimum": 0 },
    "tick": { "type": "integer", "minimum": 0 },
    "event": {
      "enum": ["accepted", "frame", "reached_goal", "collision", "stuck", "timed_out", "failed"]
    },
    "payload": { "type": "object", "maxProperties": 64 }
  }
}
